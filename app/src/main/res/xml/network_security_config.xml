<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production defaults: HTTPS only and system-trusted certificates. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production API domain: require HTTPS and trusted system certificates -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">movieapi.zarhosting.dpdns.org</domain>
        <domain includeSubdomains="true">moviebox.ph</domain>
        <domain includeSubdomains="true">aoneroom.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow user-installed certificates only in debuggable builds. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
