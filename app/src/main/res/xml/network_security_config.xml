<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic as base fallback, trust both system and user CAs -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Production API domain: require HTTPS and trusted system certificates -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">movieapi.zarhosting.dpdns.org</domain>
        <domain includeSubdomains="true">moviebox.ph</domain>
        <domain includeSubdomains="true">aoneroom.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
